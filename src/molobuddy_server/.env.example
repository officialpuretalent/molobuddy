NODE_ENV=development
HOST=127.0.0.1
PORT=8080
REGION_KEY=za1
RELEASE_ID=local
LOG_LEVEL=info
# Every origin the Flutter web app is served from must be listed here, or the
# app loads and then fails every API call. 4300 is the documented default for
# `flutter run -d web-server --web-port 4300`; 3000 is kept for existing
# setups. Wildcards are rejected at startup. Add a port here whenever you
# change --web-port.
CORS_ALLOWED_ORIGINS=http://localhost:4300,http://127.0.0.1:4300,http://localhost:3000,http://127.0.0.1:3000

# Development only. Production must use AUTH_VERIFIER=firebase.
AUTH_VERIFIER=local
LOCAL_AUTH_ID_TOKEN=molo-local-id-token
LOCAL_APP_CHECK_TOKEN=molo-local-app-check-token
LOCAL_AUTH_UID=local_demo_user
LOCAL_AUTH_DISPLAY_NAME=Molo Demo
LOCAL_AUTH_EMAIL=demo@molo.local
LOCAL_AUTH_EMAIL_VERIFIED=true

# Required with AUTH_VERIFIER=firebase. Credentials come from ADC, not this file.
FIREBASE_PROJECT_ID=molobuddy-development
