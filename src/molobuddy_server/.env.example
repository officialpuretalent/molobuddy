NODE_ENV=development
HOST=127.0.0.1
PORT=8080
REGION_KEY=za1
RELEASE_ID=local
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Development only. Production must use AUTH_VERIFIER=firebase.
AUTH_VERIFIER=local
LOCAL_AUTH_ID_TOKEN=molo-local-id-token
LOCAL_APP_CHECK_TOKEN=molo-local-app-check-token
LOCAL_AUTH_UID=local_demo_user
LOCAL_AUTH_DISPLAY_NAME=Molo Demo
LOCAL_AUTH_EMAIL=demo@molo.local
LOCAL_AUTH_EMAIL_VERIFIED=true

# Required with AUTH_VERIFIER=firebase. Credentials come from ADC, not this file.
FIREBASE_PROJECT_ID=
