{
  "name": "@molobuddy/server",
  "version": "0.1.0",
  "private": true,
  "description": "MoloBuddy Node.js backend",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "audit:production": "npm audit --omit=dev --omit=optional --audit-level=high",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev": "tsx watch --env-file=.env.local src/entrypoints/control_api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "start": "node --enable-source-maps dist/src/entrypoints/control_api.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:contract": "npm run build && node --test dist/test/contract/*.test.js",
    "test:firestore": "npm run build && firebase emulators:exec --only firestore --project molobuddy-development --config ../../firebase.json \"$npm_node_execpath --test dist/test/integration/firestore/*.test.js\"",
    "test:integration": "npm run build && node --test dist/test/integration/*.test.js",
    "test:unit": "npm run build && node --test dist/test/unit/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.1",
    "firebase-admin": "14.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
